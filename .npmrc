# @emoji-mart/react@1.x declares peer react "^16.8 || ^17 || ^18" and has not
# published a React 19 range, so a plain `npm install` / `npm ci` fails with
# ERESOLVE on this project (React 19). The component itself is React-19 safe
# (it only uses refs + createElement). Accept the stale peer range so local
# installs and CI/Vercel builds resolve deterministically from the lockfile.
legacy-peer-deps=true
